{
  "name": "right-click-mention",
  "displayName": "Right Click Mention",
  "description": "右クリックから選択範囲やファイルの参照を Claude Code のチャットに追加する（非公式）",
  "version": "0.0.5",
  "publisher": "kip2",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kip2/right-click-mention.git"
  },
  "bugs": {
    "url": "https://github.com/kip2/right-click-mention/issues"
  },
  "homepage": "https://github.com/kip2/right-click-mention#readme",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p ./",
    "build": "npm run clean && npm run compile",
    "watch": "tsc -watch -p ./",
    "lint": "oxlint --report-unused-disable-directives",
    "pretest": "npm run build",
    "test": "node --test \"out/test/unit/**/*.test.js\"",
    "test:spec": "npm run build && node --test --test-reporter=spec \"out/test/unit/**/*.test.js\"",
    "pretest:integration": "npm run build",
    "test:integration": "node out/test/integration/runTest.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~20.19.43",
    "@types/vscode": "~1.94.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "mocha": "^12.0.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "configuration": {
      "title": "Right Click Mention",
      "properties": {
        "rightClickMention.explorerFiles": {
          "type": "string",
          "enum": [
            "paste",
            "open"
          ],
          "enumDescriptions": [
            "ファイルを開かずに、参照をチャットの入力欄に貼り付ける。タブは開かない。クリップボードの中身は参照に置き換わる",
            "ファイルを一瞬開いて、公式拡張のコマンドで入れる。クリップボードは変わらない。開いたタブは入れたあとで閉じる"
          ],
          "default": "paste",
          "scope": "window",
          "markdownDescription": "エクスプローラーから「Claudeのチャットに追加」したときの、ファイルの入れ方です。フォルダと、画像などテキストとして開けないファイルは、どちらの設定でも貼り付けで入れます。エディタの右クリックには関係ありません。"
        }
      }
    },
    "commands": [
      {
        "command": "rightClickMention.sendSelection",
        "title": "選択範囲をClaudeのチャットに追加",
        "category": "Right Click Mention"
      },
      {
        "command": "rightClickMention.sendCurrentFile",
        "title": "このファイルをClaudeのチャットに追加",
        "category": "Right Click Mention"
      },
      {
        "command": "rightClickMention.sendFile",
        "title": "Claudeのチャットに追加",
        "category": "Right Click Mention"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rightClickMention.sendSelection",
          "when": "editorHasSelection && !config.claudeCode.useTerminal",
          "group": "navigation@100"
        },
        {
          "command": "rightClickMention.sendCurrentFile",
          "when": "!editorHasSelection && !config.claudeCode.useTerminal",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "rightClickMention.sendFile",
          "when": "!config.claudeCode.useTerminal",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "rightClickMention.sendSelection",
          "when": "editorLangId && !config.claudeCode.useTerminal"
        },
        {
          "command": "rightClickMention.sendCurrentFile",
          "when": "editorLangId && !config.claudeCode.useTerminal"
        },
        {
          "command": "rightClickMention.sendFile",
          "when": "false"
        }
      ]
    }
  }
}
