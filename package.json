{
  "name": "right-click-mention",
  "displayName": "Right Click Mention",
  "description": "右クリックから選択範囲やファイルをClaude Codeのチャットに送る",
  "version": "0.0.1",
  "publisher": "kip2",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kip2/right-click-mention.git"
  },
  "bugs": {
    "url": "https://github.com/kip2/right-click-mention/issues"
  },
  "homepage": "https://github.com/kip2/right-click-mention#readme",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node test/run-unit.js",
    "test:spec": "npm run compile && node test/run-unit.js --test-reporter=spec",
    "pretest:integration": "npm run compile",
    "test:integration": "node test/integration/runTest.js",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/vscode": "~1.94.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "mocha": "^10.8.2",
    "typescript": "^5.6.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "rightClickMention.sendSelection",
        "title": "Claudeに選択範囲を送る"
      },
      {
        "command": "rightClickMention.sendCurrentFile",
        "title": "Claudeにこのファイルを送る"
      },
      {
        "command": "rightClickMention.sendFile",
        "title": "Claudeにファイルを送る"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rightClickMention.sendSelection",
          "when": "editorHasSelection && !config.claudeCode.useTerminal",
          "group": "navigation@100"
        },
        {
          "command": "rightClickMention.sendCurrentFile",
          "when": "!editorHasSelection && !config.claudeCode.useTerminal",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "rightClickMention.sendFile",
          "when": "!explorerResourceIsFolder && !config.claudeCode.useTerminal",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "rightClickMention.sendSelection",
          "when": "!config.claudeCode.useTerminal"
        },
        {
          "command": "rightClickMention.sendCurrentFile",
          "when": "!config.claudeCode.useTerminal"
        },
        {
          "command": "rightClickMention.sendFile",
          "when": "false"
        }
      ]
    }
  }
}
