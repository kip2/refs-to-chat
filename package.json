{
  "name": "refs-to-chat",
  "displayName": "Refs to Chat",
  "description": "右クリックから、選択範囲・ファイル・フォルダの参照（@ファイル#行）を Claude Code のチャットに追加する（非公式）",
  "version": "0.1.0",
  "publisher": "kip2",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kip2/refs-to-chat.git"
  },
  "bugs": {
    "url": "https://github.com/kip2/refs-to-chat/issues"
  },
  "homepage": "https://github.com/kip2/refs-to-chat#readme",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p ./",
    "build": "npm run clean && npm run compile",
    "watch": "tsc -watch -p ./",
    "lint": "oxlint --report-unused-disable-directives",
    "pretest": "npm run build",
    "test": "node --test \"out/test/unit/**/*.test.js\"",
    "test:spec": "npm run build && node --test --test-reporter=spec \"out/test/unit/**/*.test.js\"",
    "pretest:integration": "npm run build",
    "test:integration": "node out/test/integration/runTest.js",
    "pretest:e2e": "node -e \"require('fs').mkdirSync('.vscode-test/e2e', { recursive: true })\" && vsce package --out .vscode-test/e2e/refs-to-chat.vsix",
    "test:e2e": "node out/test/e2e/run.js",
    "pretest:e2e:setup": "npm run build",
    "test:e2e:setup": "node out/test/e2e/setup.js",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "~20.19.43",
    "@types/vscode": "~1.94.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "mocha": "^12.0.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "configuration": {
      "title": "Refs to Chat",
      "properties": {
        "refsToChat.explorerClipboard": {
          "type": "string",
          "enum": [
            "use",
            "keep"
          ],
          "enumDescriptions": [
            "クリップボードを使う。ファイルを開かずに入れる。クリップボードの中身は書き換わる",
            "ファイルではクリップボードを使わない。かわりに、ファイルのタブが一瞬開いて閉じる"
          ],
          "default": "use",
          "scope": "window",
          "markdownDescription": "エクスプローラーから「Claudeのチャットに追加」したときに、クリップボードを使うかどうかを選びます。`keep` にしても、フォルダ、画像などテキストとして開けないファイル、チャットに追加できなかったときは、クリップボードを使います（元の中身は戻りません）。"
        },
        "refsToChat.markdownPreview": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Markdown のプレビューの右クリックメニューに「選択範囲をClaudeのチャットに追加」を出します。`false` にすると出しません。"
        },
        "refsToChat.previewClipboard": {
          "type": "string",
          "enum": [
            "use",
            "keep"
          ],
          "enumDescriptions": [
            "クリップボードを使う。元のファイルを開かずに入れる。クリップボードの中身は書き換わる",
            "クリップボードを使わない。かわりに、元のファイルのタブが一瞬開いて閉じる"
          ],
          "default": "use",
          "scope": "window",
          "markdownDescription": "Markdown のプレビューから「選択範囲をClaudeのチャットに追加」したときに、クリップボードを使うかどうかを選びます。`keep` にしても、チャットに追加できなかったときは、クリップボードを使います（元の中身は戻りません）。"
        }
      }
    },
    "markdown.previewScripts": [
      "./media/markdownPreview.js"
    ],
    "commands": [
      {
        "command": "refsToChat.sendSelection",
        "title": "選択範囲をClaudeのチャットに追加",
        "category": "Refs to Chat"
      },
      {
        "command": "refsToChat.sendCurrentFile",
        "title": "このファイルをClaudeのチャットに追加",
        "category": "Refs to Chat"
      },
      {
        "command": "refsToChat.sendFile",
        "title": "Claudeのチャットに追加",
        "category": "Refs to Chat"
      },
      {
        "command": "refsToChat.sendPreviewSelection",
        "title": "選択範囲をClaudeのチャットに追加",
        "category": "Refs to Chat"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "refsToChat.sendSelection",
          "when": "editorHasSelection && !config.claudeCode.useTerminal",
          "group": "navigation@100"
        },
        {
          "command": "refsToChat.sendCurrentFile",
          "when": "!editorHasSelection && !config.claudeCode.useTerminal",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "refsToChat.sendFile",
          "when": "!config.claudeCode.useTerminal",
          "group": "navigation@100"
        }
      ],
      "webview/context": [
        {
          "command": "refsToChat.sendPreviewSelection",
          "when": "(webviewId == 'markdown.preview' || webviewId == 'vscode.markdown.preview.editor') && refsToChatPreviewSelection && config.refsToChat.markdownPreview && !config.claudeCode.useTerminal",
          "group": "navigation@100"
        }
      ],
      "commandPalette": [
        {
          "command": "refsToChat.sendSelection",
          "when": "editorLangId && !config.claudeCode.useTerminal"
        },
        {
          "command": "refsToChat.sendCurrentFile",
          "when": "editorLangId && !config.claudeCode.useTerminal"
        },
        {
          "command": "refsToChat.sendFile",
          "when": "false"
        },
        {
          "command": "refsToChat.sendPreviewSelection",
          "when": "false"
        }
      ]
    }
  }
}
